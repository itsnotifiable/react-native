{
  "name": "@notifiable/react-native",
  "version": "0.1.3",
  "description": "React Native SDK for Notifiable.",
  "homepage": "https://notifiable.sh",
  "keywords": [
    "notifiable",
    "react-native",
    "push-notifications",
    "notifications"
  ],
  "author": {
    "name": "Notifiable",
    "url": "https://notifiable.sh"
  },
  "contributors": [
    {
      "name": "Othmane N.",
      "url": "https://github.com/iietmoon"
    }
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "react-native": "./src/index.ts",
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "lib",
    "ios",
    "android",
    "notifiable-react-native.podspec",
    "README.md",
    "LICENSE",
    ".github/ressources/icon.png"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsnotifiable/react-native.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.21.0",
    "react": ">=18",
    "react-native": ">=0.73"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-test-renderer": "^19.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  }
}
